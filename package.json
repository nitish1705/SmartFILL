{
  "name": "smartfill",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && npm run typecheck -w @smartfill/extension",
    "eval": "tsx eval/run.ts",
    "dev": "npm run dev -w @smartfill/extension",
    "build": "npm run build -w @smartfill/extension",
    "zip": "npm run zip -w @smartfill/extension"
  },
  "overrides": { "@vitejs/plugin-react": "^4.3.4" },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.14.0",
    "jsdom": "^25.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "vite": "^6.3.0"
  }
}
